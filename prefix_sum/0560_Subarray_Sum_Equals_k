#include <vector>
#include <unordered_map>
using namespace std;

// LeetCode 560
// Problem: Subarray Sum Equals K
// Difficulty: Medium
// Topic: Prefix Sum + HashMap
// Time Complexity: O(n)
// Space Complexity: O(n)

class Solution {
public:
    int subarraySum(vector<int>& nums, int k) {
        int n = nums.size();
        int count = 0;

        vector<int> prefixSum(n, 0);

        // Build Prefix Sum
        prefixSum[0] = nums[0];

        for(int i = 1; i < n; i++) {
            prefixSum[i] = prefixSum[i - 1] + nums[i];
        }

        // HashMap: prefix sum -> frequency
        unordered_map<int, int> m;

        for(int j = 0; j < n; j++) {

            // If subarray starts from index 0
            if(prefixSum[j] == k) {
                count++;
            }

            // Find required previous prefix sum
            int val = prefixSum[j] - k;

            if(m.find(val) != m.end()) {
                count += m[val];
            }

            // Store current prefix sum
            if(m.find(prefixSum[j]) == m.end()) {
                m[prefixSum[j]] = 0;
            }

            m[prefixSum[j]]++;
        }

        return count;
    }
};